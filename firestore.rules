rules_version = '2';

// WiseWorkout Firestore security rules.
//
// Replaces the previous wide-open default template
// (`allow read, write: if request.auth != null` on `/{document=**}`),
// which granted every signed-in user full read/write access to every
// document in the database. Every collection/subcollection below was
// re-derived directly from actual read/write call sites in
// lib/services/firestore_service.dart (plus a small number of
// self-scoped direct-Firestore calls in a few screens) during a full
// investigation pass earlier this session — nothing here is guessed.
//
// Anything not explicitly matched below falls through to the default-deny
// catch-all at the bottom (rule 18) — there is no permissive fallback.
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────
    // 1. users/{uid} — private profile + all owner-only subcollections
    // ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // 3. Private workout data — never read cross-user (challenge
      // progress is computed from the caller's own sessions only, then
      // shared via publicProfiles/progressCache instead).
      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // 4. Mutual-friend mirror docs. A user can always manage their own
      // friends list (request.auth.uid == uid), but acceptFriendRequest()
      // also writes a mirrored doc into the OTHER user's friends
      // subcollection from the accepting user's own client — the doc id
      // there is always the writer's own uid, so
      // request.auth.uid == otherUid (the doc-id path segment) lets a
      // user write only the entry that represents themselves into
      // someone else's list, never fabricate a third party's entry.
      match /friends/{otherUid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null &&
          (request.auth.uid == otherUid || request.auth.uid == uid);
      }

      // 5. Pending friend requests. sendFriendRequest() writes into the
      // RECIPIENT's subcollection from the sender's client, with the doc
      // id always equal to the sender's own uid — same doc-id-matching
      // trick as friends/ above, tightened further by also requiring the
      // written fromUid field to agree.
      match /friendRequests/{fromUid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null &&
          request.auth.uid == fromUid &&
          request.resource.data.fromUid == fromUid;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      // Sender-side mirror of a pending friend request
      // (users/{uid}/sentFriendRequests/{toUid}) — lets a user check "did
      // I already send this?" via hasSentFriendRequest() as a self-scoped
      // read, instead of needing to read the recipient's private
      // friendRequests inbox above (which owner-only rules correctly deny
      // to anyone but the recipient). Read/create stay strictly sender-
      // only (sendFriendRequest() writes this under its own uid). Delete
      // is also permitted from the RECIPIENT's side via the same doc-id-
      // matching trick as friends/{otherUid} above: acceptFriendRequest()/
      // declineFriendRequest() run on the recipient's device and need to
      // clean up the sender's marker there, so request.auth.uid == toUid
      // lets a user delete only the entry representing themselves as the
      // addressee, never anyone else's.
      match /sentFriendRequests/{toUid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
        allow delete: if request.auth != null && request.auth.uid == toUid;
      }

      // 6. Notifications. Written cross-uid by the SENDER's client into
      // the RECIPIENT's subcollection (sendFriendRequest/
      // acceptFriendRequest/createChallenge/the client-side challenge-
      // progress fallback/acceptCoachRequest) — unlike friends/
      // friendRequests, notification doc ids are auto-generated, not
      // derivable from the writer's uid, so a doc-id-matching trick
      // isn't available here. Best achievable rule: the notification's
      // own fromUid field must equal the writer (stops sender
      // impersonation) and its type must be one of the known values this
      // app actually sends — this can't fully prevent a malicious
      // signed-in user from spamming notifications into someone else's
      // inbox, but it closes impersonation and arbitrary payload shapes.
      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null &&
          request.resource.data.fromUid == request.auth.uid &&
          request.resource.data.type in
            ['friend_request', 'friend_accepted', 'challenge_invite', 'challenge_friend_progress', 'admin_broadcast', 'coach_request_accepted'];
        // Owner-only, and restricted to the read/status toggle fields
        // markNotificationRead()/respondToChallengeInvite() actually
        // write — not a general-purpose rewrite of someone's own
        // notification.
        allow update: if request.auth != null && request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'status']);
      }

      // 9. Every remaining users/{uid} subcollection — owner-only,
      // uniformly. No client code anywhere reads/writes any of these
      // across users.
      match /planProgress/{planId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /inProgressSessions/{sessionRunId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /missedSessions/{date} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /xpEvents/{eventId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /weightLogs/{date} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /customRoutines/{routineId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /nutritionLogs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /dailyActivityLog/{date} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /earnedBadges/{badgeId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ─────────────────────────────────────────────────────────────────
    // 2. publicProfiles/{uid} — denormalized leaderboard-safe mirror.
    // Any authenticated user needs to read another user's row for
    // getFriendsLeaderboardStream()'s whereIn query; only the profile
    // owner's own client ever writes it (updateUserProfile()/
    // saveOnboardingStep1()/addXpToUser() all write under the same uid
    // as the caller).
    // ─────────────────────────────────────────────────────────────────
    match /publicProfiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ─────────────────────────────────────────────────────────────────
    // 7. follows/{followerUid_followingUid} — one-directional follow
    // edges. Follower counts/following counts query across ALL users'
    // follow docs, so read is open to any authenticated user. followUser
    // ()/unfollowUser() always write the doc whose followerUid field
    // equals the caller — using that explicit field (present on every
    // doc) rather than parsing the doc id is simpler and equally safe.
    // ─────────────────────────────────────────────────────────────────
    match /follows/{followId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.followerUid == request.auth.uid;
      allow delete: if request.auth != null &&
        resource.data.followerUid == request.auth.uid;
    }

    // ─────────────────────────────────────────────────────────────────
    // 8. plans/{planId} — Explore browses the whole collection, so read
    // is open to any authenticated user. Only a user-created custom plan
    // (isCustom:true, createdBy set at creation) can ever be created/
    // edited/deleted by a client; admin-created plans have no createdBy
    // field at all, so resource.data.createdBy == request.auth.uid is
    // false for every client on those, making them unwritable.
    // ─────────────────────────────────────────────────────────────────
    match /plans/{planId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.isCustom == true &&
        request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.createdBy == request.auth.uid;
    }

    // ─────────────────────────────────────────────────────────────────
    // 10. Admin-managed reference data — public read, never client-
    // writable. exercises/injuryCategories/challengeCategories/appConfig
    // all follow this exact same shape; no write method for any of them
    // exists anywhere in the app.
    // ─────────────────────────────────────────────────────────────────
    match /exercises/{exerciseId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /injuryCategories/{categoryId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /challengeCategories/{categoryId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /appConfig/{configId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /badges/{badgeId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────
    // 11–13. Challenges.
    // ─────────────────────────────────────────────────────────────────
    match /challenges/{challengeId} {
      // Global (public) challenges are readable by anyone; private ones
      // only by participants and users who've been invited (an invitee
      // needs to read the doc to see what they're being invited to,
      // before deciding whether to accept).
      allow read: if request.auth != null &&
        (resource.data.isGlobal == true ||
         request.auth.uid in resource.data.participantUids ||
         request.auth.uid in resource.data.invitedUids);

      // createChallenge() always writes isGlobal:false, createdBy:uid —
      // a client can never create a public (isGlobal:true) challenge;
      // only an admin setting that field directly in the Console can.
      allow create: if request.auth != null &&
        request.resource.data.isGlobal == false &&
        request.resource.data.createdBy == request.auth.uid;

      // Two ways to legitimately update this doc:
      //   (a) the creator, for any field (no edit UI exists yet, but
      //       this is the natural forward-looking allowance);
      //   (b) any other authenticated user, but ONLY touching
      //       participantUids/invitedUids, and only ever adding/removing
      //       THEIR OWN uid from either array — never someone else's
      //       membership. Validated with .removeAll([request.auth.uid])
      //       on both the old and new array: if stripping the caller's
      //       own uid from each produces identical lists before and
      //       after, the only possible difference was that uid's
      //       presence/absence — no other element could have changed.
      //       Tightened beyond the literal ask: a self-add to
      //       participantUids is only valid if the challenge is public
      //       (isGlobal:true, matching joinChallenge()) OR the caller was
      //       actually in invitedUids before this update and is being
      //       removed from it in the same write (matching acceptChallengeInvite()/
      //       respondToChallengeInvite()) — this closes a gap the literal
      //       task text didn't cover: without it, anyone could self-add
      //       to a PRIVATE challenge's participantUids with no invite at
      //       all, bypassing the invite system entirely.
      allow update: if request.auth != null && (
        resource.data.createdBy == request.auth.uid ||
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['participantUids', 'invitedUids']) &&
          request.resource.data.invitedUids.removeAll([request.auth.uid]) ==
            resource.data.invitedUids.removeAll([request.auth.uid]) &&
          request.resource.data.participantUids.removeAll([request.auth.uid]) ==
            resource.data.participantUids.removeAll([request.auth.uid]) &&
          (
            request.resource.data.participantUids == resource.data.participantUids ||
            resource.data.isGlobal == true ||
            (request.auth.uid in resource.data.invitedUids &&
             !(request.auth.uid in request.resource.data.invitedUids))
          )
        )
      );

      // 12. progressCache/{uid} — readable by any participant of the
      // parent challenge (a get() on the parent doc, to check
      // participantUids), writable only by the cache-owner's own client.
      // The Cloud Function (checkChallengeProgressOnSessionCreate in
      // functions/index.js) writes here too, via the Admin SDK, which
      // bypasses these rules entirely — no allowance needed for it.
      match /progressCache/{uid} {
        allow read: if request.auth != null &&
          request.auth.uid in
            get(/databases/$(database)/documents/challenges/$(challengeId)).data.participantUids;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      // 13. progressNotifications/{recipientUid_friendUid_date} — purely
      // an internal once-per-day dedup marker. The CLIENT-side fallback
      // (_maybeNotifyFriendsOfProgress() in firestore_service.dart) does
      // read this before deciding whether to notify — read isn't fully
      // unnecessary the way the original investigation assumed. Doc ids
      // never contain underscores within a uid segment (Firebase Auth
      // uids are plain alphanumeric, confirmed against this project's own
      // real user ids), so splitting on '_' reliably isolates the middle
      // segment (the uid of the friend whose progress increased) and
      // restricts access to that uid only.
      match /progressNotifications/{docId} {
        allow read, write: if request.auth != null &&
          docId.split('_')[1] == request.auth.uid;
      }
    }

    // ─────────────────────────────────────────────────────────────────
    // 14. businessPartners/{uid} — coach registration (Part 1) writes
    // this doc directly as the applicant, via registerAsCoach() in
    // firestore_service.dart. A user may create ONLY their own
    // application (doc id == caller's uid), and only if submitted as
    // unapproved/invisible — isApproved/isVisible must stay admin-only
    // fields, so create is rejected outright if either is anything but
    // false, closing off self-approval/self-publishing at write time
    // rather than relying on the client to behave. Update/delete stay
    // fully blocked for every client — no admin-bypass rule exists in
    // this file yet (that's the separate admin-approval work); once it
    // lands, its rules should be additive here, not a replacement of
    // this block.
    // ─────────────────────────────────────────────────────────────────
    match /businessPartners/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.auth.uid == uid &&
        request.resource.data.isApproved == false &&
        request.resource.data.isVisible == false;
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────
    // coachRequests/{autoId} — "Request as my coach" from
    // find_professional_screen.dart, written via sendCoachRequest() in
    // firestore_service.dart. Top-level with an auto-generated doc id
    // (not a users/{uid} subcollection like friendRequests), so unlike
    // that collection's doc-id-matching trick, this checks the clientUid
    // field itself: a user may only create a request where they are the
    // requesting client, never fabricate one on someone else's behalf or
    // impersonate the coach side. Read is open to either party named on
    // the doc (the client who sent it, or the coach it's addressed to).
    // Update/delete are now allowed for the COACH side only (matching
    // coachUid) — acceptCoachRequest()/declineCoachRequest() in
    // firestore_service.dart both run on the coach's own device/session,
    // deleting the resolved request; the client never needs to
    // update/delete a request they sent (there's no "cancel my request"
    // feature), so this is intentionally coach-only, not both parties.
    // ─────────────────────────────────────────────────────────────────
    match /coachRequests/{requestId} {
      allow read: if request.auth != null &&
        (resource.data.clientUid == request.auth.uid ||
         resource.data.coachUid == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.clientUid == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.coachUid == request.auth.uid;
    }

    // ─────────────────────────────────────────────────────────────────
    // coachClients/{coachUid_clientUid} — written by
    // acceptCoachRequest() in firestore_service.dart when a coach
    // accepts a pending request. Top-level with a composite doc id
    // (coachUid_clientUid), not a users/{uid} subcollection like
    // friends/, so — same reasoning as coachRequests above — this
    // checks the coachUid/clientUid FIELDS on the doc rather than
    // matching a path segment. Read is open to either party (coach
    // viewing their client list; client, in future, viewing who their
    // coach is). Write (create/update/delete) is coach-only — this
    // relationship is asymmetric, only the coach side ever manages it
    // (accepting, and in future possibly removing a client); the client
    // has no corresponding action that needs write access here.
    // ─────────────────────────────────────────────────────────────────
    match /coachClients/{clientRelationId} {
      allow read: if request.auth != null &&
        (resource.data.coachUid == request.auth.uid ||
         resource.data.clientUid == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.coachUid == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.coachUid == request.auth.uid;
    }

    // ─────────────────────────────────────────────────────────────────
    // 15–17. Social feed.
    // ─────────────────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
      // toggleReaction()/addComment()/deleteComment() update someone
      // else's post purely to keep the denormalized reactionCount/
      // commentCount in sync — never any other field. affectedKeys()
      // restricts WHICH fields may change at all; the two equality
      // checks additionally require each field, if touched, to move by
      // exactly +/-1 (matching FieldValue.increment(1)/increment(-1)'s
      // real usage) rather than being set to an arbitrary value.
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionCount', 'commentCount']) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reactionCount']) ||
          request.resource.data.reactionCount == resource.data.reactionCount + 1 ||
          request.resource.data.reactionCount == resource.data.reactionCount - 1
        ) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['commentCount']) ||
          request.resource.data.commentCount == resource.data.commentCount + 1 ||
          request.resource.data.commentCount == resource.data.commentCount - 1
        );
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;

      // 16. One reaction per user per post — doc id is always the
      // reacting user's own uid.
      match /reactions/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      // 17. Comments — anyone can add one (own uid enforced on the
      // comment doc itself), only the comment's author can delete it.
      // No update method exists anywhere, so no update rule is granted.
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null &&
          request.resource.data.uid == request.auth.uid;
        allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      }
    }

    // ─────────────────────────────────────────────────────────────────
    // 18. Default deny. Anything not explicitly matched above — because
    // Firestore evaluates every matching rule for a path and grants
    // access if ANY of them allow it, this catch-all never overrides a
    // more specific `allow` above; it only closes off paths nothing else
    // covers.
    // ─────────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
